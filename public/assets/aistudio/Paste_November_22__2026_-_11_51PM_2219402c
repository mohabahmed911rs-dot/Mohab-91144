    // =========================================================================
    // 4. DOCUMENT RENDERERS (CV, RESUME, COVER LETTER)
    // =========================================================================
    function renderDocument() {
      const container = document.getElementById('document-preview');
      const langClass = state.docLang === 'en' ? 'doc-en' : 'doc-ar';
      container.className = `a4-paper rounded-2xl border border-slate-200 ${langClass}`;

      const d = state.data;
      const L = LABELS[state.docLang];

      // Empty state check
      const hasAnyData = d.personal.fullName || d.personal.email || d.experience.length || d.education.length;
      if (!hasAnyData) {
        container.innerHTML = `
          <div class="min-h-[297mm] flex flex-col items-center justify-center p-10 text-center text-slate-400">
            <div class="w-16 h-16 rounded-2xl bg-slate-100 flex items-center justify-center mb-4">
              <i data-lucide="file-plus" class="w-8 h-8 text-slate-400"></i>
            </div>
            <p class="text-base font-bold text-slate-600 mb-1">${L.emptyHint}</p>
          </div>
        `;
        lucide.createIcons();
        return;
      }

      if (state.docType === 'cv') {
        container.innerHTML = renderCV(d, L);
      } else if (state.docType === 'resume') {
        container.innerHTML = renderResume(d, L);
      } else {
        container.innerHTML = renderCoverLetter(d, L);
      }

      lucide.createIcons();
    }

    // Inline SVG Icons for crisp printing inside document
    const SVG_ICONS = {
      phone: `<svg class="w-3.5 h-3.5 shrink-0 text-sky-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>`,
      mail: `<svg class="w-3.5 h-3.5 shrink-0 text-sky-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>`,
      pin: `<svg class="w-3.5 h-3.5 shrink-0 text-sky-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>`,
      globe: `<svg class="w-3.5 h-3.5 shrink-0 text-sky-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>`
    };

    function renderBullets(text) {
      if (!text) return '';
      const lines = text.split('\n').map(l => l.trim()).filter(Boolean);
      if (!lines.length) return '';
      return `
        <ul class="mt-1.5 space-y-1 text-[11.5px] text-slate-700 leading-relaxed list-disc list-outside ps-4">
          ${lines.map(l => `<li>${escapeHtml(l)}</li>`).join('')}
        </ul>
      `;
    }

    // -------------------- A. FULL ACADEMIC CV RENDERER --------------------
    function renderCV(d, L) {
      const p = d.personal;

      return `
        <div class="grid grid-cols-12 min-h-[297mm]">
