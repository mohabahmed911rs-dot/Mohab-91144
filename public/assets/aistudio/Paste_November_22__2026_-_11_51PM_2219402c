          </aside>

          <!-- Compact White Main Area -->
          <div class="col-span-12 sm:col-span-8 p-6 flex flex-col gap-4 bg-white">
            <header class="border-b-2 border-slate-900 pb-3">
              <div class="text-[10px] font-extrabold tracking-[0.2em] uppercase text-sky-700 mb-0.5">${L.resumeTag}</div>
              <h1 class="text-2xl font-extrabold text-slate-900 leading-tight">${escapeHtml(p.fullName || 'Your Name')}</h1>
              ${p.title ? `<p class="text-sm font-semibold text-slate-600 mt-0.5">${escapeHtml(p.title)}</p>` : ''}
            </header>

            ${p.profile ? `
              <section>
                <h2 class="text-xs font-extrabold tracking-wider uppercase text-slate-900 border-b border-slate-200 pb-1 mb-1.5">${L.resumeProfile}</h2>
                <p class="text-[11px] text-slate-700 leading-relaxed">${escapeHtml(p.profile)}</p>
              </section>
            ` : ''}

            ${topExp.length ? `
              <section>
                <h2 class="text-xs font-extrabold tracking-wider uppercase text-slate-900 border-b border-slate-200 pb-1 mb-2">${L.experience}</h2>
                <div class="space-y-3">
                  ${topExp.map(exp => `
                    <div class="avoid-break">
                      <div class="flex items-baseline justify-between gap-2">
                        <h3 class="text-[12px] font-bold text-slate-900">${escapeHtml(exp.role)}</h3>
                        <span class="text-[10.5px] font-bold text-sky-700 shrink-0">${escapeHtml(exp.period)}</span>
                      </div>
                      <div class="text-[11px] font-semibold text-slate-600">${escapeHtml(exp.company)}${exp.location ? ` • ${escapeHtml(exp.location)}` : ''}</div>
                      ${renderBullets(exp.achievements)}
                    </div>
                  `).join('')}
                </div>
              </section>
            ` : ''}

            ${topEdu.length ? `
              <section>
                <h2 class="text-xs font-extrabold tracking-wider uppercase text-slate-900 border-b border-slate-200 pb-1 mb-2">${L.education}</h2>
                <div class="space-y-2">
                  ${topEdu.map(edu => `
                    <div class="avoid-break">
                      <div class="flex items-baseline justify-between gap-2">
                        <h3 class="text-[12px] font-bold text-slate-900">${escapeHtml(edu.degree)}</h3>
                        <span class="text-[10.5px] font-bold text-sky-700 shrink-0">${escapeHtml(edu.year)}</span>
                      </div>
                      <div class="text-[11px] text-slate-600">${escapeHtml(edu.institution)}${edu.location ? ` — ${escapeHtml(edu.location)}` : ''}</div>
                    </div>
                  `).join('')}
                </div>
              </section>
            ` : ''}
          </div>
        </div>
      `;
    }

    // -------------------- C. 1-PAGE COVER LETTER RENDERER --------------------
    function renderCoverLetter(d, L) {
      const p = d.personal;
      const cl = d.coverLetter;

      const defaultIntro = state.docLang === 'en'
        ? `I am writing to express my strong interest in the ${cl.targetRole || p.title || 'open'} position at ${cl.company || 'your organization'}. ${p.profile || ''}`
        : `أتقدم إليكم بهذا الخطاب للتعبير عن اهتمامي الكبير بالتقدم لوظيفة ${cl.targetRole || p.title || 'المعلن عنها'} لدى ${cl.company || 'مؤسستكم الموقرة'}. ${p.profile || ''}`;

      return `
        <div class="min-h-[297mm] flex flex-col bg-white">
          <!-- Formal Dark Header -->
          <header class="print-header-dark bg-[#1e293b] text-white px-10 py-8">
            <div class="text-[10.5px] font-extrabold tracking-[0.2em] uppercase text-sky-400 mb-1">${L.coverTag}</div>
            <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight">${escapeHtml(p.fullName || 'Your Name')}</h1>
            ${p.title ? `<p class="text-sm text-slate-300 mt-1">${escapeHtml(p.title)}</p>` : ''}
            <div class="flex flex-wrap items-center gap-x-5 gap-y-1.5 mt-4 text-xs text-slate-300">
              ${p.phone ? `<span class="flex items-center gap-1.5">${SVG_ICONS.phone}<span dir="ltr">${escapeHtml(p.phone)}</span></span>` : ''}
              ${p.email ? `<span class="flex items-center gap-1.5">${SVG_ICONS.mail}<span>${escapeHtml(p.email)}</span></span>` : ''}
              ${p.location ? `<span class="flex items-center gap-1.5">${SVG_ICONS.pin}<span>${escapeHtml(p.location)}</span></span>` : ''}
            </div>
          </header>

          <!-- Letter Body -->
          <div class="p-10 flex-1 flex flex-col gap-6 text-[13px] text-slate-800 leading-relaxed">
            <!-- Date & Recipient -->
            <div class="flex flex-col sm:flex-row sm:justify-between gap-4 border-b border-slate-200 pb-5">
              <div class="space-y-0.5">
                <div class="font-bold text-slate-900">${escapeHtml(cl.hiringManager || L.hiringManagerFallback)}</div>
                ${cl.company ? `<div class="font-semibold text-slate-700">${escapeHtml(cl.company)}</div>` : ''}
                ${cl.targetRole ? `<div class="text-xs text-sky-700 font-semibold">${escapeHtml(cl.targetRole)}</div>` : ''}
              </div>
              <div class="text-xs font-semibold text-slate-500">
                ${escapeHtml(cl.date || new Date().toLocaleDateString(state.docLang === 'en' ? 'en-GB' : 'ar-EG', { day: 'numeric', month: 'long', year: 'numeric' }))}
              </div>
            </div>

            <!-- Salutation -->
            <div class="font-bold text-slate-900">
              ${L.dear} ${escapeHtml(cl.hiringManager || L.hiringManagerFallback)},
            </div>

            <!-- 3-4 Structured Paragraphs -->
            <div class="space-y-4 text-justify">
              <p>${escapeHtml(cl.intro || defaultIntro)}</p>
              ${cl.body ? `<p>${escapeHtml(cl.body)}</p>` : ''}
              ${cl.closing ? `<p>${escapeHtml(cl.closing)}</p>` : ''}
            </div>

            <!-- Sign-off -->
            <div class="mt-6 pt-4">
              <p class="text-slate-600 mb-3">${L.sincerely}</p>
              <p class="text-base font-extrabold text-slate-900">${escapeHtml(p.fullName || '')}</p>
              ${p.title ? `<p class="text-xs text-slate-500">${escapeHtml(p.title)}</p>` : ''}
            </div>
          </div>
        </div>
      `;
    }

    // Boot Application
    window.addEventListener('DOMContentLoaded', init);
  </script>
</body>
</html>