    // =========================================================================
    // 2. INITIALIZATION & UI CONTROLS
    // =========================================================================
    function init() {
      // Start with rich sample data so the user immediately sees the exact CV design
      state.data = JSON.parse(JSON.stringify(SAMPLE_DATA[state.docLang]));
      syncFormInputs();
      renderDynamicLists();
      updateTabsUI();
      updateLangUI();
      renderDocument();
      lucide.createIcons();
    }

    function setDocType(type) {
      state.docType = type;
      updateTabsUI();
      renderDocument();
      // Auto-expand cover letter section when cover letter tab is selected
      if (type === 'cover_letter') {
        const el = document.getElementById('sec-cover');
        const icon = document.getElementById('icon-sec-cover');
        if (el.classList.contains('hidden')) {
          el.classList.remove('hidden');
          icon.classList.add('rotate-180');
        }
      }
    }

    function setDocLang(lang) {
      if (state.docLang === lang) return;
      state.docLang = lang;
      updateLangUI();
      renderDocument();
      showToast(lang === 'en' ? 'تم تحويل اتجاه ولغة المستند إلى الإنجليزية (LTR)' : 'تم تحويل اتجاه ولغة المستند إلى العربية (RTL)');
    }

    function updateTabsUI() {
      const map = { cv: 'tab-cv', resume: 'tab-resume', cover_letter: 'tab-cover' };
      Object.entries(map).forEach(([key, id]) => {
        const btn = document.getElementById(id);
        if (key === state.docType) {
          btn.className = 'px-3 sm:px-4 py-1.5 rounded-lg text-xs sm:text-sm font-bold bg-slate-900 text-white shadow-sm transition-all';
        } else {
          btn.className = 'px-3 sm:px-4 py-1.5 rounded-lg text-xs sm:text-sm font-bold text-slate-600 hover:text-slate-900 transition-all';
        }
      });
      updateSpecBanner();
    }

    function updateLangUI() {
      const enBtn = document.getElementById('lang-en');
      const arBtn = document.getElementById('lang-ar');
      if (state.docLang === 'en') {
        enBtn.className = 'px-2.5 py-1 rounded-lg text-xs font-bold bg-slate-900 text-white shadow-sm transition-all';
        arBtn.className = 'px-2.5 py-1 rounded-lg text-xs font-bold text-slate-600 hover:text-slate-900 transition-all';
      } else {
        arBtn.className = 'px-2.5 py-1 rounded-lg text-xs font-bold bg-slate-900 text-white shadow-sm transition-all';
        enBtn.className = 'px-2.5 py-1 rounded-lg text-xs font-bold text-slate-600 hover:text-slate-900 transition-all';
      }
    }

    function updateSpecBanner() {
      const title = document.getElementById('spec-title');
      const desc = document.getElementById('spec-desc');
      const badge = document.getElementById('spec-badge');

      if (state.docType === 'cv') {
        title.textContent = 'مواصفات الـ CV الأكاديمي الشامل (Curriculum Vitae)';
        badge.textContent = 'شامل • متعدد الصفحات';
        desc.textContent = 'مخصص للمجالات الأكاديمية، البحثية، العلمية، الزمالات والتعليم العالي. يشمل تسلسلاً زمنياً مفصلاً للخبرات، المنشورات العلمية، المشاريع البحثية، المؤتمرات، المنح، الجوائز والشهادات.';
      } else if (state.docType === 'resume') {
        title.textContent = 'مواصفات الملخص المهني (Resume)';
        badge.textContent = 'مختصر • صفحة واحدة';
        desc.textContent = 'مخصص للتقديم في الشركات والقطاع الخاص والصناعي. يعرض ملخصاً مركزاً ومخصصاً لأهم الخبرات العملية بإنجازات رقمية، المهارات الأساسية، والتعليم في صفحة واحدة أنيقة.';
      } else {
        title.textContent = 'مواصفات خطاب التقديم (Cover Letter)';
        badge.textContent = 'رسمي • صفحة واحدة (3-4 فقرات)';
        desc.textContent = 'يُرفق مع الـ CV أو الـ Resume لإظهار حماسك وإقناع مسؤول التوظيف بأنك المرشح الأمثل عبر 3 إلى 4 فقرات منظمة ورسمية.';
      }
    }

    function toggleSection(id) {
      const content = document.getElementById(id);
      const icon = document.getElementById('icon-' + id);
      const isHidden = content.classList.contains('hidden');
      if (isHidden) {
        content.classList.remove('hidden');
        icon.classList.add('rotate-180');
      } else {
        content.classList.add('hidden');
        icon.classList.remove('rotate-180');
      }
    }

    function loadSampleData() {
      state.data = JSON.parse(JSON.stringify(SAMPLE_DATA[state.docLang]));
      syncFormInputs();
      renderDynamicLists();
      renderDocument();
      showToast('تمت تعبئة بيانات تجريبية كاملة مطابقة للدليل');
    }

    function openClearModal() {
      const m = document.getElementById('clear-modal');
      m.classList.remove('hidden');
      m.classList.add('flex');
    }

    function closeClearModal() {
      const m = document.getElementById('clear-modal');
      m.classList.add('hidden');
      m.classList.remove('flex');
    }

    function confirmClearData() {
      state.data = getEmptyData();
      syncFormInputs();
      renderDynamicLists();
      renderDocument();
      closeClearModal();
      showToast('تم مسح جميع البيانات، يمكنك البدء بملء بياناتك الآن');
    }

    function scrollToPreview() {
      renderDocument();
      const target = document.getElementById('document-preview');
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      showToast('تم إنشاء وتحديث المستند بنجاح!');
    }

    function printDocument() {
      window.print();
    }

    let toastTimer = null;
    function showToast(msg) {
      const toast = document.getElementById('toast');
      document.getElementById('toast-msg').textContent = msg;
      toast.classList.remove('translate-y-20', 'opacity-0');
      toast.classList.add('translate-y-0', 'opacity-100');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => {
        toast.classList.add('translate-y-20', 'opacity-0');
        toast.classList.remove('translate-y-0', 'opacity-100');
      }, 3000);
    }

    // =========================================================================
    // 3. FORM DATA BINDING & DYNAMIC LISTS
    // =========================================================================
    function syncFormInputs() {
      const p = state.data.personal;
      document.getElementById('input-fullName').value = p.fullName || '';
      document.getElementById('input-title').value = p.title || '';
      document.getElementById('input-phone').value = p.phone || '';
      document.getElementById('input-email').value = p.email || '';
      document.getElementById('input-location').value = p.location || '';
      document.getElementById('input-website').value = p.website || '';
      document.getElementById('input-profile').value = p.profile || '';

      document.getElementById('input-skills').value = (state.data.skills || []).join(', ');
      document.getElementById('input-languages').value = (state.data.languages || []).join(', ');

      const cl = state.data.coverLetter;
      document.getElementById('input-cl-date').value = cl.date || '';
      document.getElementById('input-cl-manager').value = cl.hiringManager || '';
      document.getElementById('input-cl-company').value = cl.company || '';
      document.getElementById('input-cl-role').value = cl.targetRole || '';
      document.getElementById('input-cl-intro').value = cl.intro || '';
      document.getElementById('input-cl-body').value = cl.body || '';
      document.getElementById('input-cl-closing').value = cl.closing || '';
    }

    function updateField(section, key, value) {
      state.data[section][key] = value;
      renderDocument();
    }

    function updateCommaList(key, value) {
      state.data[key] = value.split(/[,،]/).map(s => s.trim()).filter(Boolean);
      renderDocument();
    }

    function addItem(listName) {
      const id = listName + '-' + Date.now();
      const templates = {
        education: { id, degree: '', institution: '', location: '', year: '', details: '' },
        experience: { id, company: '', role: '', location: '', period: '', achievements: '' },
        publications: { id, title: '', journal: '', year: '', coauthors: '' },
        research: { id, title: '', institution: '', role: '', year: '', description: '' },
        conferences: { id, title: '', type: 'Conference', organization: '', year: '', details: '' },
        awards: { id, title: '', issuer: '', year: '' },
        certifications: { id, title: '', issuer: '', year: '' }
      };
      state.data[listName].push(templates[listName]);
      renderDynamicLists();
      renderDocument();
    }

    function removeItem(listName, index) {
      state.data[listName].splice(index, 1);
      renderDynamicLists();
      renderDocument();
    }

    function updateListItem(listName, index, field, value) {
      if (state.data[listName][index]) {
        state.data[listName][index][field] = value;
        renderDocument();
      }
    }

    function escapeAttr(str) {
      return String(str || '')
        .replace(/&/g, '&amp;')
        .replace(/"/g, '&quot;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');
    }

    function escapeHtml(str) {
      return String(str || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');
    }

    function renderDynamicLists() {
