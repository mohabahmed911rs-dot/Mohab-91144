<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>منشئ السيرة الذاتية الأكاديمية والمهنية | CV Studio</title>

  <!-- Google Fonts: Cairo (Arabic) & Inter (English) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Lucide Icons CDN -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            arabic: ['Cairo', 'sans-serif'],
            english: ['Inter', 'sans-serif'],
          },
          colors: {
            navy: {
              800: '#1e293b',
              900: '#0f172a',
            }
          }
        }
      }
    }
  </script>

  <style>
    /* Base UI Typography */
    body {
      font-family: 'Cairo', sans-serif;
      background-color: #f1f5f9;
      color: #0f172a;
    }

    /* Document Language Typography */
    .doc-en {
      font-family: 'Inter', sans-serif;
      direction: ltr;
      text-align: left;
    }
    .doc-ar {
      font-family: 'Cairo', sans-serif;
      direction: rtl;
      text-align: right;
    }

    /* Custom Scrollbar for Form */
    .custom-scroll::-webkit-scrollbar {
      width: 6px;
    }
    .custom-scroll::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    .custom-scroll::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 9999px;
    }
    .custom-scroll::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }

    /* A4 Sheet Styling on Screen */
    .a4-paper {
      width: 100%;
      max-width: 210mm;
      min-height: 297mm;
      background: #ffffff;
      box-shadow: 0 20px 25px -5px rgba(15, 23, 42, 0.1), 0 8px 10px -6px rgba(15, 23, 42, 0.08);
      margin: 0 auto;
      overflow: hidden;
    }

    /* Avoid awkward page splits inside entries */
    .avoid-break {
      break-inside: avoid;
      page-break-inside: avoid;
    }

    /* Print Media Rules for Crisp A4 PDF Export */
    @media print {
      @page {
        size: A4 portrait;
        margin: 0;
      }

      html, body {
        background: #ffffff !important;
        margin: 0 !important;
        padding: 0 !important;
        width: 210mm !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }

      .no-print {
        display: none !important;
      }

      #print-wrapper {
        display: block !important;
        padding: 0 !important;
        margin: 0 !important;
        width: 100% !important;
        max-width: none !important;
      }

      .a4-paper {
        box-shadow: none !important;
        border-radius: 0 !important;
        width: 210mm !important;
        max-width: 210mm !important;
        min-height: 297mm !important;
        margin: 0 !important;
      }

      .print-sidebar {
        background-color: #1e293b !important;
        color: #f8fafc !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }

      .print-header-dark {
        background-color: #1e293b !important;
        color: #ffffff !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }
    }
  </style>
</head>
<body class="min-h-screen flex flex-col">

  <!-- ==================== TOP NAVIGATION BAR ==================== -->
  <header class="no-print sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-slate-200 shadow-sm">
    <div class="max-w-[1600px] mx-auto px-4 sm:px-6 py-3 flex flex-wrap items-center justify-between gap-3">
      <!-- Brand -->
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-slate-900 text-white flex items-center justify-center shadow-sm">
          <i data-lucide="file-text" class="w-5 h-5"></i>
        </div>
        <div>
          <h1 class="text-base sm:text-lg font-extrabold text-slate-900 leading-tight">منشئ السيرة الذاتية الاحترافي</h1>
          <p class="text-xs text-slate-500">مطابق للمواصفات الأكاديمية والمهنية (CV • Resume • Cover Letter)</p>
        </div>
      </div>

      <!-- Document Mode Switcher -->
      <div class="flex items-center bg-slate-100 p-1 rounded-xl border border-slate-200">
        <button id="tab-cv" onclick="setDocType('cv')" class="px-3 sm:px-4 py-1.5 rounded-lg text-xs sm:text-sm font-bold transition-all">
          CV الأكاديمي
        </button>
        <button id="tab-resume" onclick="setDocType('resume')" class="px-3 sm:px-4 py-1.5 rounded-lg text-xs sm:text-sm font-bold transition-all">
          Resume (صفحة)
        </button>
        <button id="tab-cover" onclick="setDocType('cover_letter')" class="px-3 sm:px-4 py-1.5 rounded-lg text-xs sm:text-sm font-bold transition-all">
          Cover Letter
        </button>
      </div>

      <!-- Action Controls -->
      <div class="flex flex-wrap items-center gap-2">
        <!-- Document Language Toggle -->
        <div class="flex items-center bg-slate-100 p-1 rounded-xl border border-slate-200" title="لغة واتجاه المستند المُنشأ">
          <button id="lang-en" onclick="setDocLang('en')" class="px-2.5 py-1 rounded-lg text-xs font-bold transition-all">EN</button>
          <button id="lang-ar" onclick="setDocLang('ar')" class="px-2.5 py-1 rounded-lg text-xs font-bold transition-all">عربي</button>
        </div>

        <button onclick="loadSampleData()" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-sky-50 text-sky-700 hover:bg-sky-100 border border-sky-200 transition-colors">
          <i data-lucide="sparkles" class="w-4 h-4"></i>
          <span>تعبئة بيانات تجريبية</span>
        </button>

        <button onclick="openClearModal()" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-white text-rose-600 hover:bg-rose-50 border border-slate-200 transition-colors">
          <i data-lucide="trash-2" class="w-4 h-4"></i>
          <span class="hidden sm:inline">مسح</span>
        </button>

        <button onclick="printDocument()" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-slate-900 text-white hover:bg-slate-800 shadow-sm transition-all">
          <i data-lucide="printer" class="w-4 h-4"></i>
          <span>طباعة / حفظ PDF</span>
        </button>
      </div>
    </div>
  </header>

  <!-- ==================== MAIN WORKSPACE ==================== -->
  <main class="flex-1 max-w-[1600px] w-full mx-auto px-4 sm:px-6 py-6 grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

    <!-- ==================== FORM PANEL (RIGHT IN RTL) ==================== -->
    <section class="no-print lg:col-span-5 flex flex-col gap-4">
      <!-- Intro Helper Card -->
      <div class="bg-white rounded-2xl border border-slate-200 p-4 shadow-sm flex items-start gap-3">
        <div class="w-9 h-9 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0 mt-0.5">
          <i data-lucide="check-circle-2" class="w-5 h-5"></i>
        </div>
        <div class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          <strong class="text-slate-900 block mb-0.5">املأ الحقول وسيتم تحديث المستند فوراً</strong>
          يمكنك إدخال بياناتك بالإنجليزية أو العربية، ثم التبديل بين <span class="font-bold text-slate-800">CV الشامل</span> و<span class="font-bold text-slate-800">Resume</span> و<span class="font-bold text-slate-800">Cover Letter</span> من الشريط العلوي.
        </div>
      </div>

      <!-- Collapsible Form Sections Container -->
      <div id="form-container" class="flex flex-col gap-3">

        <!-- 1. Personal & Contact -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
          <button type="button" onclick="toggleSection('sec-personal')" class="w-full px-4 py-3.5 flex items-center justify-between text-right bg-slate-50/70 hover:bg-slate-50 transition-colors">
            <div class="flex items-center gap-2.5">
              <span class="w-7 h-7 rounded-lg bg-slate-900 text-white flex items-center justify-center text-xs font-bold">1</span>
              <span class="font-bold text-slate-800 text-sm">البيانات الشخصية والتواصل</span>
            </div>
            <i data-lucide="chevron-down" id="icon-sec-personal" class="w-4 h-4 text-slate-500 transition-transform rotate-180"></i>
          </button>
          <div id="sec-personal" class="p-4 border-t border-slate-100 grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div class="sm:col-span-2">
              <label class="block text-xs font-bold text-slate-600 mb-1">الاسم الكامل</label>
              <input type="text" id="input-fullName" oninput="updateField('personal','fullName',this.value)" placeholder="مثال: Dr. Sarah Ahmed / سارة أحمد" class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-slate-900/15 focus:border-slate-900" />
            </div>
            <div class="sm:col-span-2">
              <label class="block text-xs font-bold text-slate-600 mb-1">المسمى الوظيفي / الأكاديمي</label>
              <input type="text" id="input-title" oninput="updateField('personal','title',this.value)" placeholder="مثال: Food Technology Researcher & Quality Specialist" class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-slate-900/15 focus:border-slate-900" />
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-600 mb-1">رقم الهاتف</label>
              <input type="text" id="input-phone" oninput="updateField('personal','phone',this.value)" placeholder="+20 123 456 7890" class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-slate-900/15 focus:border-slate-900" />
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-600 mb-1">البريد الإلكتروني</label>
              <input type="email" id="input-email" oninput="updateField('personal','email',this.value)" placeholder="name@university.edu.eg" class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-slate-900/15 focus:border-slate-900" />
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-600 mb-1">الموقع (المدينة، الدولة)</label>
              <input type="text" id="input-location" oninput="updateField('personal','location',this.value)" placeholder="Cairo, Egypt" class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-slate-900/15 focus:border-slate-900" />
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-600 mb-1">LinkedIn / ORCID / Google Scholar</label>
              <input type="text" id="input-website" oninput="updateField('personal','website',this.value)" placeholder="linkedin.com/in/username" class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-slate-900/15 focus:border-slate-900" />
            </div>
            <div class="sm:col-span-2">
              <label class="block text-xs font-bold text-slate-600 mb-1">النبذة الشخصية والأكاديمية (Profile)</label>
              <textarea id="input-profile" rows="3" oninput="updateField('personal','profile',this.value)" placeholder="ملخص مختصر وقوي يوضح خبراتك وأهدافك البحثية أو المهنية..." class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-slate-900/15 focus:border-slate-900"></textarea>
            </div>
          </div>
        </div>

        <!-- 2. Academic Education -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
          <button type="button" onclick="toggleSection('sec-education')" class="w-full px-4 py-3.5 flex items-center justify-between text-right bg-slate-50/70 hover:bg-slate-50 transition-colors">
            <div class="flex items-center gap-2.5">
              <span class="w-7 h-7 rounded-lg bg-slate-900 text-white flex items-center justify-center text-xs font-bold">2</span>
              <span class="font-bold text-slate-800 text-sm">التعليم الأكاديمي (Education)</span>
              <span id="count-education" class="text-xs px-2 py-0.5 rounded-full bg-slate-200 text-slate-700 font-bold">0</span>
            </div>
            <i data-lucide="chevron-down" id="icon-sec-education" class="w-4 h-4 text-slate-500 transition-transform"></i>
          </button>
          <div id="sec-education" class="hidden p-4 border-t border-slate-100 space-y-3">
            <div id="list-education" class="space-y-3"></div>
            <button type="button" onclick="addItem('education')" class="w-full py-2 rounded-xl border-2 border-dashed border-slate-300 text-slate-600 hover:border-slate-900 hover:text-slate-900 text-xs font-bold flex items-center justify-center gap-1.5 transition-colors">
              <i data-lucide="plus" class="w-4 h-4"></i>
              <span>إضافة مؤهل أكاديمي</span>
            </button>
          </div>
        </div>

        <!-- 3. Experience -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
          <button type="button" onclick="toggleSection('sec-experience')" class="w-full px-4 py-3.5 flex items-center justify-between text-right bg-slate-50/70 hover:bg-slate-50 transition-colors">
            <div class="flex items-center gap-2.5">
              <span class="w-7 h-7 rounded-lg bg-slate-900 text-white flex items-center justify-center text-xs font-bold">3</span>
              <span class="font-bold text-slate-800 text-sm">الخبرات العملية والإنجازات (Experience)</span>
              <span id="count-experience" class="text-xs px-2 py-0.5 rounded-full bg-slate-200 text-slate-700 font-bold">0</span>
            </div>
            <i data-lucide="chevron-down" id="icon-sec-experience" class="w-4 h-4 text-slate-500 transition-transform"></i>
          </button>
          <div id="sec-experience" class="hidden p-4 border-t border-slate-100 space-y-3">
            <p class="text-xs text-slate-500 bg-slate-50 p-2.5 rounded-xl border border-slate-200">
              نصيحة: اكتب كل إنجاز في سطر منفصل، واستخدم أرقاماً ونسباً مئوية (مثال: 25% زيادة في الكفاءة) كما هو موضح في الدليل.
            </p>
            <div id="list-experience" class="space-y-3"></div>
            <button type="button" onclick="addItem('experience')" class="w-full py-2 rounded-xl border-2 border-dashed border-slate-300 text-slate-600 hover:border-slate-900 hover:text-slate-900 text-xs font-bold flex items-center justify-center gap-1.5 transition-colors">
              <i data-lucide="plus" class="w-4 h-4"></i>
              <span>إضافة خبرة عملية</span>
            </button>
          </div>
        </div>

        <!-- 4. Publications & Research Projects -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
          <button type="button" onclick="toggleSection('sec-research')" class="w-full px-4 py-3.5 flex items-center justify-between text-right bg-slate-50/70 hover:bg-slate-50 transition-colors">
            <div class="flex items-center gap-2.5">
              <span class="w-7 h-7 rounded-lg bg-slate-900 text-white flex items-center justify-center text-xs font-bold">4</span>
              <span class="font-bold text-slate-800 text-sm">المنشورات والأبحاث العلمية (CV)</span>
              <span id="count-research-total" class="text-xs px-2 py-0.5 rounded-full bg-slate-200 text-slate-700 font-bold">0</span>
            </div>
            <i data-lucide="chevron-down" id="icon-sec-research" class="w-4 h-4 text-slate-500 transition-transform"></i>
          </button>
          <div id="sec-research" class="hidden p-4 border-t border-slate-100 space-y-5">
            <!-- Publications -->
            <div class="space-y-2.5">
              <h4 class="text-xs font-extrabold text-slate-700 uppercase tracking-wide flex items-center gap-1.5">
                <i data-lucide="book-open" class="w-3.5 h-3.5 text-sky-600"></i>
                المنشورات العلمية (Extensive Publications)
              </h4>
              <div id="list-publications" class="space-y-3"></div>
              <button type="button" onclick="addItem('publications')" class="w-full py-2 rounded-xl border-2 border-dashed border-slate-300 text-slate-600 hover:border-slate-900 hover:text-slate-900 text-xs font-bold flex items-center justify-center gap-1.5 transition-colors">
                <i data-lucide="plus" class="w-4 h-4"></i>
                <span>إضافة بحث منشور</span>
              </button>
            </div>
            <hr class="border-slate-100" />
            <!-- Research Projects -->
            <div class="space-y-2.5">
              <h4 class="text-xs font-extrabold text-slate-700 uppercase tracking-wide flex items-center gap-1.5">
                <i data-lucide="flask-conical" class="w-3.5 h-3.5 text-sky-600"></i>
                المشاريع البحثية (Research Projects)
              </h4>
              <div id="list-research" class="space-y-3"></div>
              <button type="button" onclick="addItem('research')" class="w-full py-2 rounded-xl border-2 border-dashed border-slate-300 text-slate-600 hover:border-slate-900 hover:text-slate-900 text-xs font-bold flex items-center justify-center gap-1.5 transition-colors">
                <i data-lucide="plus" class="w-4 h-4"></i>
                <span>إضافة مشروع بحثي</span>
              </button>
            </div>
          </div>
        </div>

        <!-- 5. Conferences, Grants & Teaching -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
          <button type="button" onclick="toggleSection('sec-conferences')" class="w-full px-4 py-3.5 flex items-center justify-between text-right bg-slate-50/70 hover:bg-slate-50 transition-colors">
            <div class="flex items-center gap-2.5">
              <span class="w-7 h-7 rounded-lg bg-slate-900 text-white flex items-center justify-center text-xs font-bold">5</span>
              <span class="font-bold text-slate-800 text-sm">المؤتمرات، المنح والخبرة التدريسية (CV)</span>
              <span id="count-conferences" class="text-xs px-2 py-0.5 rounded-full bg-slate-200 text-slate-700 font-bold">0</span>
            </div>
            <i data-lucide="chevron-down" id="icon-sec-conferences" class="w-4 h-4 text-slate-500 transition-transform"></i>
          </button>
          <div id="sec-conferences" class="hidden p-4 border-t border-slate-100 space-y-3">
            <div id="list-conferences" class="space-y-3"></div>
            <button type="button" onclick="addItem('conferences')" class="w-full py-2 rounded-xl border-2 border-dashed border-slate-300 text-slate-600 hover:border-slate-900 hover:text-slate-900 text-xs font-bold flex items-center justify-center gap-1.5 transition-colors">
              <i data-lucide="plus" class="w-4 h-4"></i>
              <span>إضافة مؤتمر / منحة / خبرة تدريسية</span>
            </button>
          </div>
        </div>

        <!-- 6. Awards & Certifications -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
          <button type="button" onclick="toggleSection('sec-awards')" class="w-full px-4 py-3.5 flex items-center justify-between text-right bg-slate-50/70 hover:bg-slate-50 transition-colors">
            <div class="flex items-center gap-2.5">
              <span class="w-7 h-7 rounded-lg bg-slate-900 text-white flex items-center justify-center text-xs font-bold">6</span>
              <span class="font-bold text-slate-800 text-sm">الجوائز والشهادات والتدريبات</span>
              <span id="count-awards-total" class="text-xs px-2 py-0.5 rounded-full bg-slate-200 text-slate-700 font-bold">0</span>
            </div>
            <i data-lucide="chevron-down" id="icon-sec-awards" class="w-4 h-4 text-slate-500 transition-transform"></i>
          </button>
          <div id="sec-awards" class="hidden p-4 border-t border-slate-100 space-y-5">
            <!-- Awards -->
            <div class="space-y-2.5">
              <h4 class="text-xs font-extrabold text-slate-700 flex items-center gap-1.5">
                <i data-lucide="award" class="w-3.5 h-3.5 text-amber-500"></i>
                الجوائز والتكريمات (Awards & Honors)
              </h4>
              <div id="list-awards" class="space-y-3"></div>
              <button type="button" onclick="addItem('awards')" class="w-full py-2 rounded-xl border-2 border-dashed border-slate-300 text-slate-600 hover:border-slate-900 hover:text-slate-900 text-xs font-bold flex items-center justify-center gap-1.5 transition-colors">
                <i data-lucide="plus" class="w-4 h-4"></i>
                <span>إضافة جائزة</span>
              </button>
            </div>
            <hr class="border-slate-100" />
            <!-- Certifications -->
            <div class="space-y-2.5">
              <h4 class="text-xs font-extrabold text-slate-700 flex items-center gap-1.5">
                <i data-lucide="badge-check" class="w-3.5 h-3.5 text-emerald-600"></i>
                الشهادات والتدريبات المكثفة (Certifications & Training)
              </h4>
              <div id="list-certifications" class="space-y-3"></div>
              <button type="button" onclick="addItem('certifications')" class="w-full py-2 rounded-xl border-2 border-dashed border-slate-300 text-slate-600 hover:border-slate-900 hover:text-slate-900 text-xs font-bold flex items-center justify-center gap-1.5 transition-colors">
                <i data-lucide="plus" class="w-4 h-4"></i>
                <span>إضافة شهادة / تدريب</span>
              </button>
            </div>
          </div>
        </div>

        <!-- 7. Skills & Languages -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
          <button type="button" onclick="toggleSection('sec-skills')" class="w-full px-4 py-3.5 flex items-center justify-between text-right bg-slate-50/70 hover:bg-slate-50 transition-colors">
            <div class="flex items-center gap-2.5">
              <span class="w-7 h-7 rounded-lg bg-slate-900 text-white flex items-center justify-center text-xs font-bold">7</span>
              <span class="font-bold text-slate-800 text-sm">المهارات واللغات (Skills & Languages)</span>
            </div>
            <i data-lucide="chevron-down" id="icon-sec-skills" class="w-4 h-4 text-slate-500 transition-transform"></i>
